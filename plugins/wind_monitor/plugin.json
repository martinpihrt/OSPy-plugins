{
  "schema_version": 1,
  "id": "wind_monitor",
  "name": "Wind Speed Monitor",
  "version": "1.2.2",
  "author": "Martin Pihrt",
  "license": "GPL-3.0",
  "ospy": {
    "min_version": "3.0.211"
  },
  "python": {
    "min_version": "3.8"
  },
  "requirements": [
    {
      "module": "smbus",
      "package": "python3-smbus",
      "required": false
    }
  ],
  "dependencies": [
    {
      "id": "database_connector",
      "required": false
    },
    {
      "id": "rs485_communication",
      "required": false
    }
  ],
  "hardware": {
    "platforms": [
      "raspberry_pi"
    ],
    "i2c": [
      {
        "alternatives": [
          "0x50",
          "0x51"
        ],
        "option": "address",
        "option_values": {
          "0x50": false,
          "0x51": true
        },
        "default": "0x50"
      }
    ]
  },
  "permissions": [
    "email",
    "files",
    "i2c",
    "system"
  ],
  "mobile": {
    "api_version": 1,
    "actions": []
  }
}
